.module-workspace
  display flex
  flex-direction column
  height 100%
  min-width 0
  background var(--main)
  color var(--text)

.module-workspace-header
  display flex
  align-items center
  justify-content space-between
  flex-shrink 0
  gap 16px
  border-bottom 1px solid var(--border)
  h2
    margin 0

.module-settings-content
  flex 1
  min-height 0
  overflow auto

.module-workspace-slot
  position absolute
  top 0
  right 0
  bottom 0

.terminal-workspace[hidden]
  display none

.module-path-input
  display flex
  gap 8px
  .ant-input
    flex 1
    min-width 0

@media (max-width: 600px)
  .module-workspace-header
    flex-wrap wrap
  .module-path-input
    flex-wrap wrap
    .ant-input
      flex-basis 100%
